SQLITE_DB_PATH=./pantry.db
AI_PROVIDER=anthropic
AI_API_KEY=

# recipe-api.com key (optional). When set, the self-hosted app shows a
# "Recipe API" tab on the Import Recipes page with structured recipes,
# USDA nutrition data, and dietary flags. Grab a free-tier key at
# https://recipe-api.com/pricing — 100 req/day / 10 req/min. The key is
# served to the Rex client via an owner-gated /api/recipe-api-key route
# and never injected into guest-mode HTML.
# RECIPE_API_KEY=rapi_...

# Pixabay fallback images for recipe cards (optional). When set, recipes
# without their own photo will display a borrowed landscape photo from
# Pixabay with courtesy photographer attribution. Pixabay Content License:
# attribution optional, free to use. Rate limit: 100 req/min. Sign up at
# https://pixabay.com/api/docs/ for a free key.
# PIXABAY_API_KEY=
# PIXABAY_FALLBACK_ENABLED=true  # default true; feature is dormant without a key

# Rex's V8 SSR fetch polyfill blocks every private/loopback IP as SSRF
# protection (see crates/rex_v8/src/fetch.rs in @limlabs/rex). getServerSideProps
# on /recipes/[slug] calls the standalone GraphQL server over HTTP to hydrate
# initial recipe data + OG tags; without this allowlist entry the fetch throws
# "fetch blocked: 127.0.0.1 resolves to a private address" and pages render
# with an empty <main> + default "Pantry Host" og:title. Must match the URL
# prefix used in the GSSP fetch.
REX_INTERNAL_ORIGIN=http://127.0.0.1:4001

# ── Share to Bluesky (AT Protocol publishing) ──────────────────────────────
# Publishing is entirely client-side (browser → your PDS); the backend isn't
# involved. All three vars are optional.
#
# Safety default: everywhere except http://127.0.0.1, publishing is dry-run
# (records are previewed, never written) until you explicitly opt in.
# ATPROTO_PUBLISH_DRY_RUN=false   # false = real publishes on this instance
#
# OAuth sovereignty (optional — off the loopback origin, sign-in otherwise
# routes through the pantryhost.app publish broker). To sign in directly
# against THIS instance instead, host your own client-metadata.json over
# public HTTPS and point the app at it. Setting this also disables the broker.
#   1. Generate the doc for your public URL:
#        npx tsx packages/app/scripts/gen-client-metadata.ts https://recipes.example.com \
#          -o packages/app/public/client-metadata.json
#   2. Serve it at https://recipes.example.com/client-metadata.json
#   3. Set the var to that URL. See docs/self-hosted-oauth.md.
# ATPROTO_CLIENT_ID=https://recipes.example.com/client-metadata.json

# Feature flags (all default to true)
# ENABLE_IMAGE_PROCESSING=false  # Skip sharp variants on upload, save disk space (Pi)
SHOW_COCKTAILDB=true              # Set to false to hide the TheCocktailDB tab on /recipes/import.
                                  # The Settings page at /settings can also toggle this — overrides
                                  # are written to packages/app/.settings-overrides.json and layered
                                  # on top of this value at request time (no server restart needed).

# ── publish-kitchen skill (Claude Code: kitchens as EPUBs for e-readers) ──
# Defaults the skill offers. Keep the values in .env.local (gitignored), not here.
# KINDLE_DRIVE_FOLDER_ID=   # Google Drive folder ID or link your e-reader imports from
# KINDLE_EMAIL=             # your @kindle.com Send to Kindle address (text-only editions)
#
# MCP publish_kitchen_book tool (runs on the MCP host; needs pandoc + ImageMagick there).
# Books are saved in packages/app/public/books/ and linked for the home network.
# BOOKS_URL=http://192.168.1.10:3000/books   # default: the IP in public/network-info.json, on APP_URL's port
# BOOKS_DIR=                                 # default: packages/app/public/books
# Send to Kindle email, only when you ask for it (puts the book on Amazon's servers):
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_FROM=you@gmail.com                    # default: SMTP_URL's user; must be on Amazon's approved sender list

# Single-user home server: true makes every trusted-network visitor (LAN, .local,
# Tailscale) an owner in both the Rex app and the Rust server. Off = guests over LAN.
PANTRY_TRUST_LAN=false
