{
  "//": [
    "Theme bootstrap, inlined at the top of <body> by both runtimes:",
    "packages/app/pages/_app.tsx (via @pantry-host/shared/theme-init; not _document.tsx, whose",
    "<body> children Rex drops) and the Rust SPA shell (packages/server/src/frontend.rs,",
    "include_str!). It applies the stored theme / palette / high-contrast before first paint,",
    "and accepts ?theme=system|light|dark to change the device's theme with no app JS (Kindle",
    "Silk 80 runs this but not the bundles). Preferences live in localStorage only. Keep it",
    "ES5: it is the one script legacy browsers run."
  ],
  "script": "(function(){if(typeof localStorage==='undefined')return;try{var q=/[?&]theme=(system|light|dark)(?:&|$)/.exec(location.search);if(q){if(q[1]==='system')localStorage.removeItem('theme-preference');else localStorage.setItem('theme-preference',q[1]);if(history.replaceState){var s=location.search.replace(/([?&])theme=(?:system|light|dark)(&|$)/,function(_,a,c){return c?a:''});history.replaceState(null,'',location.pathname+(s==='?'?'':s)+location.hash)}}var b=document.body,t=localStorage.getItem('theme-preference')||'system',hcStored=localStorage.getItem('high-contrast'),hc=hcStored!==null?hcStored==='true':matchMedia('(prefers-contrast:more)').matches,p=localStorage.getItem('theme-palette');if(!p){var m=document.querySelector('meta[name=\"default-palette\"]');if(m)p=m.getAttribute('content')}if(t!=='system')b.dataset.colorScheme=t;if(hc)b.dataset.highContrast='';if(p&&p!=='default')b.dataset.theme=p;var dark=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches);b.style.colorScheme=dark?'dark':'light'}catch(e){}})()"
}
